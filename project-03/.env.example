# Projekat 3 — konfiguracija (kopirati u .env; docker compose je automatski čita).
# Ceo pipeline ide preko MQTT-a (Mosquitto). eKuiper + MaaS integracija su MQTT/REST.

# ── MQTT garancije isporuke ───────────────────────────────────────────────
# 0 = at most once, 1 = at least once, 2 = exactly once
MQTT_QOS=1

# ── Ingestion (simulacija uređaja) ────────────────────────────────────────
# Demo default je NIZAK protok da bi CEP događaji i ML predikcije bili pregledni.
DEVICE_COUNT=5              # broj simuliranih uređaja
MSG_RATE=1                  # poruka po sekundi po uređaju
CRITICAL_MODE=false         # true = >50°C očitavanja -> eKuiper HIGH_TEMP + Analytics alarm

# ── Analytics (tumbling window + CEP + MaaS) ──────────────────────────────
ALERT_THRESHOLD=50          # °C — prosek prozora iznad ovoga -> KRITIČAN ALARM
WINDOW_SECONDS=10           # dužina fiksnog (tumbling) prozora
EVENTS_TOPIC=iot/events     # topic na koji eKuiper šalje detektovane događaje
ALERTS_TOPIC=iot/alerts     # topic na koji Analytics (opciono) šalje obogaćene alarme

# ── Storage (batching / I/O) ──────────────────────────────────────────────
STORAGE_WRITE_ENABLED=true  # false = bez upisa u bazu
STORAGE_BATCH_SIZE=500      # grupni upis na svakih N poruka
STORAGE_FLUSH_MS=2000       # ili flush na svakih N ms
